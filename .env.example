# === Telegram Bot ===
TG_BOT_TOKEN=your_bot_token_here
TG_ALLOWED_USERS=123456789,987654321
# TG_PROXY_URL=socks5://user:pass@host:port
# TG_PROXY_READ_TIMEOUT=5

# === Gemini AI ===
GEMINI_API_KEY=your_gemini_api_key_here

# === HH.ru Search ===
SEARCH_TEXT=Python Developer
AREA_CODE=113
MAX_PAGES=3

# === Rate Limits ===
MAX_APPS_PER_DAY=50
MAX_APPS_PER_HOUR=10

# === Anti-Fraud Delays (seconds) ===
DELAY_MIN=5
DELAY_MAX=15
DELAY_BETWEEN_PAGES=10

# === Browser ===

# === Proxy (optional) ===
# PROXY_URL=socks5://user:pass@host:port

# === Auto Schedule (optional, 24h format) ===
# AUTO_START_HOUR=9
# AUTO_STOP_HOUR=18

# === Data Directory ===
DATA_DIR=./data

# === Logging ===
# LOG_LEVEL=INFO # Logging level (DEBUG, INFO, WARNING, ERROR)
