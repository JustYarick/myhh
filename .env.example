# === Telegram Bot ===
TG_BOT_TOKEN=your_bot_token_here
TG_ALLOWED_USERS=123456789,987654321
# Optional: proxy for the Telegram Bot API
# TG_PROXY_URL=socks5://user:pass@host:port

# === Gemini AI ===
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: proxy for Gemini API calls
# GEMINI_PROXY_URL=http://user:pass@host:port

# === HH.ru Mobile API ===
# Optional: proxy used by the HH.ru API client for all requests
# PROXY_URL=http://user:pass@host:port

# === Logging ===
# LOG_LEVEL=INFO # Logging level (DEBUG, INFO, WARNING, ERROR)

# === Data Directory ===
DATA_DIR=./data